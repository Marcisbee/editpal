{
	"name": "editpal",
	"version": "0.1.3",
	"description": "A Preact Markdown editor with visible source markers, a basic editing mode, and a read-only renderer.",
	"type": "module",
	"main": "./dist/editpal.js",
	"module": "./dist/editpal.js",
	"types": "./dist/mod.d.ts",
	"exports": {
		".": {
			"types": "./dist/mod.d.ts",
			"import": "./dist/editpal.js",
			"default": "./dist/editpal.js"
		},
		"./style.css": "./dist/style.css",
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md"
	],
	"sideEffects": [
		"./dist/style.css"
	],
	"scripts": {
		"build": "deno task build",
		"check": "deno task check",
		"dev": "deno task dev",
		"jsr:provenance": "node scripts/publish-jsr-provenance.mjs",
		"pack:check": "deno task package",
		"prepack": "deno task verify",
		"preview": "deno task preview",
		"test:e2e": "playwright test",
		"test": "deno task test",
		"verify": "deno task verify",
		"version": "deno run --allow-read --allow-write scripts/sync-jsr-version.ts && git add deno.json"
	},
	"peerDependencies": {
		"exome": "^2.8.1",
		"preact": "^10.29.7"
	},
	"devDependencies": {
		"@playwright/test": "^1.61.1",
		"exome": "^2.8.1",
		"preact": "^10.29.7",
		"sigstore": "4.1.1",
		"typescript": "6.0.3"
	},
	"engines": {
		"node": ">=18"
	},
	"keywords": [
		"editor",
		"markdown",
		"preact",
		"rich-text",
		"wysiwym"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Marcisbee/editpal.git"
	},
	"homepage": "https://github.com/Marcisbee/editpal#readme",
	"bugs": {
		"url": "https://github.com/Marcisbee/editpal/issues"
	},
	"author": "Marcis Bergmanis",
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	}
}
