{
	"$schema": "https://deno.land/x/deno/cli/schemas/config-file.v1.json",
	"name": "@marcisbee/editpal",
	"version": "0.1.0",
	"exports": "./src/editpal.tsx",
	"nodeModulesDir": "none",
	"imports": {
		"@deno/esbuild-plugin": "jsr:@deno/esbuild-plugin@^1.2.1",
		"@std/assert": "jsr:@std/assert@^1.0.19",
		"esbuild": "npm:esbuild@^0.28.1",
		"exome": "npm:exome@^2.8.1",
		"exome/preact": "npm:exome@^2.8.1/preact",
		"preact": "npm:preact@^10.29.7",
		"preact/compat": "npm:preact@^10.29.7/compat",
		"preact/hooks": "npm:preact@^10.29.7/hooks",
		"preact/jsx-runtime": "npm:preact@^10.29.7/jsx-runtime"
	},
	"compilerOptions": {
		"jsx": "react-jsx",
		"jsxImportSource": "preact",
		"strict": true
	},
	"tasks": {
		"dev": "deno run --allow-env --allow-net --allow-read --allow-run --allow-write scripts/build.ts dev",
		"build": "deno run --allow-env --allow-read --allow-run --allow-write scripts/build.ts build",
		"types": "npm exec -- tsc -p tsconfig.build.json",
		"preview": "deno run --allow-env --allow-net --allow-read --allow-run --allow-write scripts/build.ts preview",
		"test": "deno test",
		"check": "deno check src/main.tsx scripts/build.ts && deno test --no-run",
		"lint": "deno lint",
		"fmt": "deno fmt",
		"verify": "deno fmt --check && deno lint && deno task check && deno test && deno task build",
		"package": "deno task verify && npm pack --dry-run --ignore-scripts && deno publish --dry-run --allow-dirty",
		"release:check": "deno run --allow-read scripts/verify-release.ts"
	},
	"publish": {
		"include": [
			"src/**/*.ts",
			"src/**/*.tsx",
			"src/style.css",
			"README.md",
			"LICENSE"
		],
		"exclude": [
			"src/**/*.test.ts",
			"src/main.tsx",
			"src/debug.tsx",
			"src/index.css"
		]
	},
	"test": {
		"include": ["src/"]
	},
	"lint": {
		"include": ["src/", "scripts/"],
		"rules": {
			"tags": ["recommended"],
			"exclude": [
				"ban-types",
				"no-empty",
				"no-explicit-any",
				"no-unused-vars",
				"no-window-prefix",
				"prefer-const"
			]
		}
	},
	"fmt": {
		"include": [
			"src/",
			"scripts/",
			"deno.json",
			"package.json",
			"tsconfig.build.json",
			"README.md",
			"LICENSE"
		],
		"useTabs": true,
		"lineWidth": 80,
		"semiColons": true,
		"singleQuote": false,
		"proseWrap": "preserve"
	},
	"exclude": ["dist/", "www/"]
}
